      "boundElements": null,
      "updated": 1765088817504,
      "link": null,
      "locked": false,
      "text": "to add Pagination to my DB's I need to \n1. add states for page to track the current page \n2. query the DB to get total items and store them\n3. set total no. of items per page \n4. perform the calculation, to render the track items \n    on current page   \n5. add the functionality for previous & next components\n    of Pagination \n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "to add Pagination to my DB's I need to \n1. add states for page to track the current page \n2. query the DB to get total items and store them\n3. set total no. of items per page \n4. perform the calculation, to render the track items \n    on current page   \n5. add the functionality for previous & next components\n    of Pagination \n",
      "autoResize": true,
      "lineHeight": 1.25
    }
