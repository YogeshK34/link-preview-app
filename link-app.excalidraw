      "isDeleted": false,
      "boundElements": [],
      "updated": 1764849687050,
      "link": null,
      "locked": false,
      "text": "~ Features \n1. added Accordion for extra info \n2. updated the backend logic (robustness)\n3. added a for loop for the og:tags, now they check \n    both the selectors, (property & name)\n4. added hostnames for different sites (preview)\n5. replaced <Image> with <img> for better display\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "~ Features \n1. added Accordion for extra info \n2. updated the backend logic (robustness)\n3. added a for loop for the og:tags, now they check \n    both the selectors, (property & name)\n4. added hostnames for different sites (preview)\n5. replaced <Image> with <img> for better display\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
